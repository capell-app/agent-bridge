                "DELETE /agent-bridge/knowledge",
                "GET /agent-bridge (capell-agent-bridge.home)",
                "GET /agent-bridge/capell",
                "GET /agent-bridge/knowledge",
                "POST /agent-bridge/capell",
                "POST /agent-bridge/knowledge"
            ],
            "auth": "public",
            "csrfExemptRoutes": [
                "DELETE /agent-bridge/capell",
                "DELETE /agent-bridge/knowledge",
                "POST /agent-bridge/capell",
                "POST /agent-bridge/knowledge"
            ],
            "signedRoutes": [],
            "tokenizedRoutes": [
                "POST /agent-bridge/capell",
                "POST /agent-bridge/knowledge"
            ],
            "webhookRoutes": [],
            "throttledRoutes": [
                "POST /agent-bridge/capell",
                "POST /agent-bridge/knowledge"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [
                "capell_agent_bridge_audit_entries.ip_address_hash",
                "capell_agent_bridge_confirmations.payload_hash",
                "capell_agent_bridge_confirmations.token",
                "capell_agent_bridge_tokens.token_hash"
            ],
            "redactedOutputClasses": [
                "Capell\\AgentBridge\\Actions\\InvokeAgentBridgeCapabilityPreviewAction",
                "Capell\\AgentBridge\\Support\\AgentBridgeAuditSanitizer"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "agent-bridge.manage-tokens",
                "agent-bridge.view-audit"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "agent-bridge.package-health",
            "label": "Agent Bridge package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\AgentBridge\\Health\\AgentBridgeHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Connect an AI assistant to Capell with personal keys, previewed drafts and a record of every action.",
        "description": "Your team already uses an AI assistant, and this lets it work on your Capell site within limits you set. Developers create keys on a user record, choose what each key may do and set an expiry date, 90 days ahead by default. Rate limits apply to each key and each address. Requests are recorded for 90 days by default with secrets hidden, and the caller's address and the address each key was created from are kept only in scrambled form. Administrators can save their own reusable prompts. It adds no pages for visitors, only one key-protected address that connected tools use.",
        "problem": "I want an AI assistant to draft pages, but not to publish or change anything unchecked.",
        "outcome": "An assistant drafts pages as one person, each change is previewed before it goes ahead and every action is recorded.",
        "faq": [
            {
                "question": "Can an AI assistant publish changes to my site by itself?",
                "answer": "No. Creating or updating a draft page and uploading an image each wait for you to approve the preview in Capell admin, and the assistant then confirms within an hour by default. Saving a scratch copy of a draft needs no approval and changes nothing visitors see."
            },
            {
                "question": "Does Agent Bridge include its own AI?",
                "answer": "No. It connects an assistant you already use, such as Claude or Cursor. The administrator screen recognises a fixed set of commands and uses no AI either."
            },
            {
                "question": "How long does a personal key last, and can I withdraw it?",
                "answer": "A new key lasts 90 days by default and cannot be set beyond a year without changing the limits in config. You can replace or withdraw it sooner, and the assistant acts only as the person the key belongs to."
            },
            {
                "question": "Can I see what an assistant has done?",
                "answer": "Yes. Administrators can read a record of every action, with secrets hidden."
            }
        ],
        "screenshots": [
            {
                "path": "docs/screenshots/agent-bridge-prompt-builder-page.png",
                "alt": "Capell AI Command Centre with a request box, suggested actions such as Create draft page and a Preview safe action button.",
                "caption": "Administrators type a request here and see what it would do before anything is confirmed."
            },
            {
                "path": "docs/screenshots/agent-bridge-prompt-builder-page-dark.png",
                "alt": "Dark theme of the Command Centre page with the request box, a Smart suggestions list and a count of 37 capabilities.",
                "caption": "The same screen in the dark admin theme."
            }
        ],
        "categories": ["admin", "operations"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    },
    "roles": ["developer-tooling"]
}
