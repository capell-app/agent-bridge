{
    "manifest-version": 3,
    "name": "capell-app/agent-bridge",
    "slug": "agent-bridge",
    "displayName": "Agent Bridge",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "preview",
    "description": "Lets AI tools like Claude Code or Cursor search, inspect and draft pages through personal keys, and preview each change before you confirm it.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\AgentBridge",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": ["capell-app/navigation"],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\AgentBridge\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": [
            "Capell\\AgentBridge\\Providers\\AgentBridgeServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeAdminPageContribution",
            "pageClass": "Capell\\AgentBridge\\Filament\\Pages\\CapellAgentBridgePromptBuilderPage",
            "labelKey": "capell-agent-bridge::admin.prompt_builder_title"
        },
        {
            "type": "schema-extender",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeUserSchemaExtenderContribution",
            "extenderClass": "Capell\\AgentBridge\\Extenders\\AgentBridgeUserSchemaExtender",
            "tag": "capell-admin:user-schema-extenders"
        },
        {
            "type": "model",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeModelsContribution",
            "modelClasses": [
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeToken",
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeConfirmation",
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeAuditEntry",
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeSavedPrompt",
                "Capell\\AgentBridge\\Models\\CapellAgentBridgeMediaUpload"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeRoutesContribution",
            "routes": [
                "capell-agent-bridge.home",
                "agent-bridge/capell/knowledge",
                "agent-bridge/capell"
            ],
            "defaultEnabledRoutes": ["agent-bridge/capell"]
        },
        {
            "type": "setting",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeSettingsContribution",
            "settingsClass": "Capell\\AgentBridge\\Settings\\AgentBridgeSettings",
            "settingsGroup": "agent_bridge",
            "settingsSchema": "Capell\\AgentBridge\\Filament\\Settings\\AgentBridgeSettingsSchema"
        },
        {
            "type": "migration",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeMigrationsContribution",
            "tables": [
                "capell_agent_bridge_tokens",
                "capell_agent_bridge_confirmations",
                "capell_agent_bridge_audit_entries",
                "capell_agent_bridge_saved_prompts",
                "capell_agent_bridge_media_uploads"
            ],
            "migrationFiles": [
                "2026_05_10_190840_01_create_capell_agent-bridge_tokens_table",
                "2026_05_10_190840_02_create_capell_agent-bridge_confirmations_table",
                "2026_05_10_190840_03_create_capell_agent-bridge_audit_entries_table",
                "2026_05_27_000001_create_capell_agent-bridge_saved_prompts_table",
                "2026_07_09_000001_add_ip_address_hash_to_agent_bridge_audit_entries_table",
                "2026_07_10_000001_drop_plaintext_ip_from_agent_bridge_audit_entries_table",
                "2026_07_20_000001_create_capell_agent_bridge_media_uploads_table",
                "2026_09_29_120000_remove_implicit_timestamp_updates_from_agent_bridge",
                "2026_11_12_000001_hash_created_from_ip_on_agent_bridge_tokens_table",
                "2026_11_12_000002_bound_agent_bridge_tokens_without_expiry",
                "2026_11_13_000001_add_human_approval_to_agent_bridge_confirmations_table",
                "2026_11_13_000002_add_limits_to_agent_bridge_tokens_table",
                "2026_11_13_000003_add_revert_points_to_agent_bridge_audit_entries_table"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeConsoleCommandsContribution",
            "commands": [
                "capell:agent-bridge-prune-audit",
                "capell:agent:connect"
            ],
            "commandClasses": [
                "Capell\\AgentBridge\\Console\\Commands\\PruneAgentBridgeAuditEntriesCommand",
                "Capell\\AgentBridge\\Console\\Commands\\AgentConnectCommand"
            ]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeAuditPruneScheduleContribution",
            "command": "capell:agent-bridge-prune-audit",
            "name": "capell-agent-bridge-prune-audit",
            "frequency": "daily",
            "retentionDaysConfig": "capell-agent-bridge.audit_retention_days"
        },
        {
            "type": "agent-capability",
            "class": "Capell\\AgentBridge\\Manifest\\AgentBridgeBuiltInCapabilitiesContribution",
            "capabilities": [
                "capell.pages.search",
                "capell.pages.inspect",
                "capell.pages.open_editor",
                "capell.pages.authoring_options",
                "capell.pages.inspect_readiness",
                "capell.pages.create_draft",
                "capell.pages.update_draft",
                "capell.packages.search",
                "capell.packages.inspect",
                "capell.sites.search",
                "capell.sites.inspect",
                "capell.sites.open_editor",
                "capell.media.upload",
                "capell.admin.page_properties.read",
                "capell.admin.term_properties.read",
                "capell.admin.page_agent_readiness.read",
                "capell.admin.site_agent_readiness.read",
                "capell.admin.blueprints.read",
                "capell.admin.page_draft.save"
            ],
            "requiresPreviewConfirmation": true
        },
        {
            "type": "health-check",
            "class": "Capell\\AgentBridge\\Health\\AgentBridgeHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "capell_agent_bridge_tokens",
            "capell_agent_bridge_confirmations",
            "capell_agent_bridge_audit_entries",
            "capell_agent_bridge_saved_prompts",
            "capell_agent_bridge_media_uploads"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "pruneAudit": "capell:agent-bridge-prune-audit",
        "connect": "capell:agent:connect"
    },
    "settings": ["Capell\\AgentBridge\\Settings\\AgentBridgeSettings"],
    "permissions": ["agent-bridge.manage-tokens", "agent-bridge.view-audit"],
    "capabilities": ["agent-bridge", "agent-bridge-admin"],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
