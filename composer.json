{
    "name": "capell-app/agent-bridge",
    "description": "Connects AI clients such as Claude and Cursor to Capell with personal keys, draft-only page edits, a preview and confirmation for each change and an audit log.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Capell\\AgentBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\AgentBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\AgentBridge\\Providers\\AgentBridgeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.72",
        "capell-app/core": "^1.0.78",
        "laravel/framework": "^12.61.1|^13.12.0",
        "laravel/mcp": "^0.6|^0.7|^0.9|^1.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-data": "^4.5",
        "spatie/laravel-package-tools": "^1.14.1"
    },
    "conflict": {
        "capell-app/privacy-center": "<1.1.10"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.25"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "test": "pest --colors=always",
        "analyze": "phpstan analyse --memory-limit=4G"
    },
    "homepage": "https://github.com/capell-app/agent-bridge",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "agents",
        "mcp",
        "laravel-mcp",
        "model-context-protocol",
        "preview-confirm",
        "audit-log",
        "cms-automation",
        "scoped-access"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/agent-bridge"
    }
}
